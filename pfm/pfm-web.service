[Unit]
Description=Personal Finance Report Web View
# Independent of the Node home-dashboard app: separate process, separate port.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spacebaar
WorkingDirectory=/home/spacebaar/Projects/home-dashboard/pfm
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/spacebaar/Projects/pfm/.venv/bin/python /home/spacebaar/Projects/home-dashboard/pfm/web.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Everything is read-only except the one directory the goals page writes to.
# Without the ReadWritePaths line below, saving a goal fails with EACCES.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/spacebaar/Projects/home-dashboard/pfm/data
PrivateTmp=true
NoNewPrivileges=true
# Nothing here needs to escalate, map memory writable-and-executable, or reach
# anything other than TCP. Cheap to assert on a service with no authentication.
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
MemoryDenyWriteExecute=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
